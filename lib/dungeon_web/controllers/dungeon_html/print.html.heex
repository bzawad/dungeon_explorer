<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dungeon Map - Print View</title>
    <style>
      @media print {
        body { 
          margin: 0; 
          background: white !important; 
        }
        .no-print { display: none !important; }
        .page-break { page-break-before: always; }
        
        /* Force background colors to print */
        * {
          -webkit-print-color-adjust: exact !important;
          color-adjust: exact !important;
        }
        
        /* Optimize map for single page printing */
        .dungeon-map {
          transform: scale(2.5);
          transform-origin: center center;
          margin: 0 auto !important;
        }
        
        .page-container {
          display: flex !important;
          justify-content: center !important;
          padding-top: 250px !important;
          padding-bottom: 20px !important;
          padding-left: 10px !important;
          margin: 0 !important;
        }
        
        .map-cell {
          width: 8px !important;
          height: 8px !important;
          font-size: 6px !important;
          border: 0.25px solid #ddd !important;
        }
        
        .map-row {
          height: 8px !important;
          line-height: 8px !important;
        }
        
        /* Duplicate terrain type styles for print */
        .floor { background: #f5f5f5 !important; }
        .wall { 
          background: white !important;
          background-image: repeating-linear-gradient(
            45deg,
            #000 0px,
            #000 1px,
            transparent 1px,
            transparent 3px
          ) !important;
        }
        .corridor { background: #e8e8e8 !important; }
        .road { background: #d0d0d0 !important; }
        .shrub { 
          background: #90EE90 !important;
          background-image: radial-gradient(circle, #228B22 10%, transparent 10%) !important;
          background-size: 3px 3px !important;
        }
        .door { background: #8B4513 !important; color: white !important; }
        .locked-door { background: #654321 !important; color: white !important; }
        .trapped-door { background: #8B4513 !important; color: red !important; }
        .locked-trapped-door { background: #654321 !important; color: red !important; }
        .secret-door { background: #8B4513 !important; color: purple !important; }
        .room-trap { background: #ff6b6b !important; color: white !important; }
        .treasure { background: #ffd700 !important; color: #8B4513 !important; }
        .trapped-treasure { background: #ffd700 !important; color: red !important; }
        .torch { background: #ff4500 !important; color: #ffd700 !important; }
        .stair-up { background: #87CEEB !important; color: #000 !important; }
        .stair-down { background: #4682B4 !important; color: white !important; }
        .pillar { background: #696969 !important; }
        .pile-of-bones { background: #f5f5f5 !important; }
        .encounter { background: #DDA0DD !important; color: #4B0082 !important; }
        .special-feature { background: #98FB98 !important; color: #006400 !important; }
        .room-label { background: #F0F8FF !important; color: #000080 !important; font-weight: bold !important; }
        .corridor-label { background: #F5F5DC !important; color: #8B4513 !important; font-weight: bold !important; }
        .area-label { background: #E6FFE6 !important; color: #006400 !important; font-weight: bold !important; }
        .building-label { background: #FFE4E1 !important; color: #8B0000 !important; font-weight: bold !important; }
        .starting-stair { background: #32CD32 !important; color: #000 !important; font-weight: bold !important; }
      }

      @page {
        margin: 0;
        padding: 0;
        size: auto;
      }

      body {
        font-family: 'Courier New', monospace;
        margin: 0;
        background: white;
        color: black;
        -webkit-print-color-adjust: exact;
        color-adjust: exact;
      }

      .page-container {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .dungeon-map {
        display: inline-block;
        margin: 0;
        background: white;
      }

      .map-row {
        display: flex;
        height: 12px;
        line-height: 12px;
      }

      .map-cell {
        width: 12px;
        height: 12px;
        position: relative;
        font-size: 8px;
        text-align: center;
        border: 0.5px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        -webkit-print-color-adjust: exact;
        color-adjust: exact;
      }

      /* Terrain types */
      .floor { background: #f5f5f5; }
      .wall { 
        background: white;
        background-image: repeating-linear-gradient(
          45deg,
          #000 0px,
          #000 1px,
          transparent 1px,
          transparent 3px
        );
      }
      .corridor { background: #e8e8e8; }
      .road { background: #d0d0d0; }
      .shrub { 
        background: #90EE90;
        background-image: radial-gradient(circle, #228B22 10%, transparent 10%);
        background-size: 3px 3px;
      }
      .door { background: #8B4513; color: white; }
      .locked-door { background: #654321; color: white; }
      .trapped-door { background: #8B4513; color: red; }
      .locked-trapped-door { background: #654321; color: red; }
      .secret-door { background: #8B4513; color: purple; }
      .room-trap { background: #ff6b6b; color: white; }
      .treasure { background: #ffd700; color: #8B4513; }
      .trapped-treasure { background: #ffd700; color: red; }
      .torch { background: #ff4500; color: #ffd700; }
      .stair-up { background: #87CEEB; color: #000; }
      .stair-down { background: #4682B4; color: white; }
      .pillar { background: #696969; }
      .pile-of-bones { background: #f5f5f5; }
      .encounter { background: #DDA0DD; color: #4B0082; }
      .special-feature { background: #98FB98; color: #006400; }
      .room-label { background: #F0F8FF; color: #000080; font-weight: bold; }
      .corridor-label { background: #F5F5DC; color: #8B4513; font-weight: bold; }
      .area-label { background: #E6FFE6; color: #006400; font-weight: bold; }
      .building-label { background: #FFE4E1; color: #8B0000; font-weight: bold; }
      .starting-stair { background: #32CD32; color: #000; font-weight: bold; }

      .controls {
        text-align: center;
        margin: 5px 0;
      }

      .btn {
        background: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        margin: 0 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        vertical-align: middle;
        font-size: 14px;
        font-family: inherit;
        height: 40px;
        box-sizing: border-box;
      }

      .btn:hover {
        background: #0056b3;
      }
    </style>
  </head>
  <body>
    <div class="page-container">
      <div class="controls no-print">
        <button onclick="window.print()" class="btn">
          <img src="/images/printer.png" alt="Print" class={ui_inline_image_classes(:small_icon)} />
          Print Map
        </button>
        <a href="/dungeon/print" class="btn">
          <img src="/images/reset.png" alt="Reset" class={ui_inline_image_classes(:small_icon)} />
          Generate New Map
        </a>
      </div>

      <div class="dungeon-map">
        <%= for y <- 0..(@dungeon.height-1) do %>
          <div class="map-row">
            <%= for x <- 0..(@dungeon.width-1) do %>
              <% tile = Map.get(@dungeon.grid, {x, y}) %>
              <div class={"map-cell #{get_tile_class(tile)}"}>
                {raw(get_tile_symbol(tile))}
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </body>
</html>
