<div class="hero min-h-screen bg-black">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-6xl font-bold text-white mb-6">
        <img
          src="/images/castle.png"
          alt="Castle"
          class={image_classes(:large_icon, ["inline", "mr-2"])}
        />Dungeon
      </h1>
      <p class="text-xl text-gray-300 mb-8">
        Generate and explore dungeons for your tabletop RPG adventures
      </p>
      <div class="space-y-4">
        <a href="/dungeon/live" class="btn btn-primary btn-lg w-full">
          <img src="/images/swords.png" alt="Adventure" class={inline_image_classes(:small_icon)} />
          Start Adventure
        </a>
        <a href="/dungeon/print" target="_blank" class="btn btn-secondary btn-outline w-full">
          <img src="/images/printer.png" alt="Print" class={inline_image_classes(:small_icon)} />
          Print Last Dungeon
        </a>
        <div class="mt-4">
          <p class="text-sm text-gray-500">
            Version {@version}
          </p>
          <p class="text-xs text-gray-600 mt-2 image-preload-status">
            Loading dungeon resources...
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
