# Default: no LLM calls. Example: export OLLAMA_MODEL=llama3:latest
export OLLAMA_MODEL=none

# Phoenix session/cookie signing+encryption secret.
# Generate one with: mix phx.gen.secret
export SECRET_KEY_BASE="CHANGE_ME__run_mix_phx_gen_secret"

# Set THEME to force a specific theme for testing (optional)
# If not set, themes will be randomly selected
# Examples: "Haunted Forest", "Ancient Castle", "Dark Caverns", etc.
export THEME="Haunted Forest"
